# =========================================================================
# CONFIGURACIÓN DE BASE DE DATOS (SUPABASE / POSTGRESQL)
# =========================================================================

# 1. URL de conexión con Pooler (Transaction Mode - Puerto 6543)
# Utilizada en producción por Next.js runtime para evitar saturar conexiones serverless.
# IMPORTANTE: Supabase requiere agregar "?pgbouncer=true&connection_limit=1" o "?connection_limit=1" al final.
DATABASE_URL="postgresql://postgres.[project-id]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# 2. URL de conexión Directa (Session Mode - Puerto 5432)
# Utilizada para ejecutar migraciones (prisma migrate deploy) en Coolify o local.
DIRECT_URL="postgresql://postgres.[project-id]:[password]@db.[project-id].supabase.co:5432/postgres"

# =========================================================================
# CONFIGURACIÓN OPCIONAL (SI SE IMPLEMENTA EN EL FUTURO)
# =========================================================================
# NEXTAUTH_SECRET="tu-secreto-nextauth-aqui"
# NEXTAUTH_URL="https://tu-dominio.vercel.app"
# NEXT_PUBLIC_APP_URL="https://tu-dominio.vercel.app"
