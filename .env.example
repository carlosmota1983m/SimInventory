# Supabase Connection Pooling (Transaction mode, port 6543) - Used by Prisma Client
DATABASE_URL="postgresql://postgres.[username]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Supabase Direct Connection (Session mode, port 5432) - Used for Prisma Migrations
DIRECT_URL="postgresql://postgres.[username]:[password]@db.[username].supabase.co:5432/postgres"

# NextAuth configuration (if used)
# NEXTAUTH_SECRET="your-next-auth-secret-here"
# NEXTAUTH_URL="https://your-domain.vercel.app"

# Application URL
# NEXT_PUBLIC_APP_URL="https://your-domain.vercel.app"
